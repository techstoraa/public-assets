
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    /* Brand Variables & Reset */
    :root {
      --ts-bg-main: #0a0e27;
      --ts-card-bg: rgba(255,255,255,0.03);
      --ts-card-border: rgba(255,255,255,0.08);
      --ts-accent-cyan: #00d9ff;
      --ts-accent-purple: #8b5cf6;
      --ts-text-primary: #f5f5f5;
      --ts-text-muted: #a1a1aa;
      --ts-accent-gold: #ffb347;
      --ts-accent-danger: #ff4a4a;
      --ts-input-bg: #0f142e;
      --ts-input-border: #23294c;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; background: var(--ts-bg-main); color: var(--ts-text-primary); line-height: 1.6; -webkit-font-smoothing: antialiased; }
    body { background: var(--ts-bg-main); color: var(--ts-text-primary); overflow-x: hidden; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; color: inherit; background: none; border: none; cursor: pointer; }
    svg { fill: none; stroke: currentColor; stroke-width: 1.8; }

    /* Layout & Shared Components */
    #scroll-progress { position: fixed; top: 0; left: 0; height: 3px; width: 0%; background: linear-gradient(90deg, var(--ts-accent-cyan), var(--ts-accent-purple)); z-index: 1000; transition: width 0.1s ease-out; }
    .section-container { max-width: 1200px; margin: 0 auto; padding: 5rem 1.25rem; position: relative; }
    .section-header { margin-bottom: 3rem; max-width: 680px; }
    .section-header h2 { font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.75rem; }
    .section-header p, .muted { color: var(--ts-text-muted); font-size: 0.95rem; }
    .section-header p { font-size: 1.05rem; }

    .badge { display: inline-block; padding: 0.35rem 0.75rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; border-radius: 4px; background: var(--ts-input-bg); border: 1px solid var(--ts-input-border); color: var(--ts-accent-cyan); margin-bottom: 1rem; }
    .badge-purple { color: var(--ts-accent-purple); border-color: var(--ts-card-border); }
    .gradient-text { background: linear-gradient(90deg, var(--ts-accent-cyan), var(--ts-accent-purple)); -webkit-background-clip: text; background-clip: text; color: transparent; }

    .ts-card { background: var(--ts-card-bg); border: 1px solid var(--ts-card-border); border-radius: 8px; padding: 1.75rem; position: relative; overflow: hidden; transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; }
    .ts-card::before { content: ""; position: absolute; inset: 0; background: radial-gradient(500px circle at var(--mouse-x, -500px) var(--mouse-y, -500px), var(--ts-card-border), transparent 40%); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; }
    .ts-card:hover::before { opacity: 1; }
    .ts-card:hover { transform: translateY(-3px); border-color: var(--ts-accent-cyan); box-shadow: 0 0 20px -8px var(--ts-accent-cyan); }

    .btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.8rem 1.6rem; font-size: 0.95rem; font-weight: 600; border-radius: 6px; transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .btn-primary { background: var(--ts-accent-cyan); color: var(--ts-bg-main); border: 1px solid var(--ts-accent-cyan); }
    .btn-primary:hover, .btn-primary:focus-visible { transform: translateY(-2px); box-shadow: 0 0 22px -2px var(--ts-accent-cyan); outline: none; }
    .btn-secondary { background: var(--ts-input-bg); color: var(--ts-text-primary); border: 1px solid var(--ts-accent-purple); }
    .btn-secondary:hover, .btn-secondary:focus-visible { transform: translateY(-2px); box-shadow: 0 0 22px -2px var(--ts-accent-purple); outline: none; }
    .btn:active { transform: translateY(0); }

    .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; transition-delay: var(--delay, 0ms); }
    .reveal.is-visible { opacity: 1; transform: translateY(0); }

    /* Hero Section */
    #hero { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 6rem 1.25rem 4rem; position: relative; overflow: hidden; }
    .hero-orb { position: absolute; width: 360px; height: 360px; border-radius: 8px; filter: blur(110px); opacity: 0.14; pointer-events: none; animation: floatOrb 18s ease-in-out infinite alternate; }
    .hero-orb-cyan { background: var(--ts-accent-cyan); top: 12%; left: 10%; }
    .hero-orb-purple { background: var(--ts-accent-purple); bottom: 12%; right: 10%; animation-delay: -9s; }
    @keyframes floatOrb { to { transform: translate(40px, -30px) scale(1.12); } }

    .hero-content { max-width: 820px; position: relative; z-index: 1; }
    #hero h1 { font-size: clamp(2.25rem, 5.5vw, 4rem); font-weight: 800; line-height: 1.12; letter-spacing: -0.03em; margin-bottom: 1.25rem; }
    .hero-word { display: inline-block; opacity: 0; transform: translateY(12px); transition: opacity 0.45s ease, transform 0.45s ease; }
    .hero-word.revealed { opacity: 1; transform: translateY(0); }
    .hero-subtext { font-size: clamp(1rem, 2vw, 1.2rem); color: var(--ts-text-muted); max-width: 640px; margin: 0 auto 2.25rem; }
    .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }

    .scroll-indicator { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 0.4rem; color: var(--ts-text-muted); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; }
    .scroll-line { width: 2px; height: 28px; background: var(--ts-card-border); border-radius: 4px; position: relative; overflow: hidden; }
    .scroll-line::after { content: ""; position: absolute; top: -50%; left: 0; width: 100%; height: 50%; background: var(--ts-accent-cyan); animation: scrollPulse 2s ease-in-out infinite; }
    @keyframes scrollPulse { to { top: 120%; } }

    /* Services Slider */
    .slider-header-row { display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2rem; }
    .slider-controls { display: flex; gap: 0.75rem; }
    .slider-btn, .service-icon { width: 42px; height: 42px; border-radius: 6px; background: var(--ts-input-bg); border: 1px solid var(--ts-input-border); display: inline-flex; align-items: center; justify-content: center; color: var(--ts-accent-cyan); transition: 0.2s ease; }
    .slider-btn { color: var(--ts-text-primary); }
    .slider-btn:hover:not(:disabled), .slider-btn:focus-visible:not(:disabled) { border-color: var(--ts-accent-cyan); box-shadow: 0 0 14px -2px var(--ts-accent-cyan); outline: none; }
    .slider-btn:disabled { opacity: 0.35; cursor: not-allowed; }

    .services-track { display: flex; gap: 1.25rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 0.5rem 0.25rem 1.25rem; cursor: grab; user-select: none; }
    .services-track::-webkit-scrollbar { display: none; }
    .services-track.is-dragging { cursor: grabbing; scroll-snap-type: none; }
    .service-card { flex: 0 0 85%; scroll-snap-align: start; display: flex; flex-direction: column; gap: 1rem; }
    .service-card:nth-child(even) .service-icon { color: var(--ts-accent-purple); }
    .service-card h3 { font-size: 1.2rem; font-weight: 700; }
    .service-card p { color: var(--ts-text-muted); font-size: 0.95rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    .slider-progress-bar { margin-top: 1rem; height: 4px; background: var(--ts-input-bg); border: 1px solid var(--ts-input-border); border-radius: 4px; overflow: hidden; }
    .slider-progress-fill { height: 100%; width: 20%; background: linear-gradient(90deg, var(--ts-accent-cyan), var(--ts-accent-purple)); transition: width 0.25s ease; }

    /* Criteria Section */
    .criteria-layout, .charts-grid, .flow-grid, .spec-details { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
    .spec-sheet { padding: 0; }
    .spec-header { padding: 1.25rem 1.75rem; border-bottom: 1px solid var(--ts-card-border); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; background: var(--ts-input-bg); }
    .spec-header h3 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .spec-status { font-size: 0.8rem; font-weight: 600; color: var(--ts-accent-gold); padding: 0.25rem 0.65rem; border: 1px solid var(--ts-accent-gold); border-radius: 4px; }
    .spec-body { padding: 2rem 1.75rem; }
    .spec-metric-row { display: flex; flex-direction: column; gap: 1rem; padding-bottom: 1.75rem; border-bottom: 1px solid var(--ts-card-border); }
    .spec-count { font-size: clamp(2.75rem, 6vw, 4.25rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: var(--ts-accent-cyan); }
    .spec-main-criterion { font-size: 1.15rem; font-weight: 600; }
    .spec-details { padding-top: 1.5rem; gap: 1rem; margin-bottom: 1.5rem; }
    .spec-detail-item { padding: 0.85rem 1rem; background: var(--ts-input-bg); border: 1px solid var(--ts-input-border); border-radius: 6px; }
    .spec-label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ts-text-muted); margin-bottom: 0.25rem; }
    .spec-value { font-size: 0.95rem; font-weight: 500; }

    .secondary-criteria-card { display: flex; flex-direction: column; justify-content: space-between; gap: 1.25rem; border-color: var(--ts-input-border); }
    .secondary-criteria-card:hover { border-color: var(--ts-accent-purple); box-shadow: 0 0 20px -8px var(--ts-accent-purple); }
    .secondary-criteria-card h3 { font-size: 1.35rem; margin-bottom: 0.5rem; }
    .standalone-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.6rem; }
    .standalone-tag { font-size: 0.8rem; padding: 0.35rem 0.7rem; background: var(--ts-input-bg); border: 1px solid var(--ts-input-border); border-radius: 4px; }

    /* Charts & Flow Section */
    .chart-card h3 { font-size: 1.1rem; margin-bottom: 0.25rem; }
    .chart-caption { font-size: 0.85rem; color: var(--ts-text-muted); margin-bottom: 1.25rem; }
    .chart-canvas-wrap { position: relative; height: 240px; width: 100%; }
    .sample-data-note { margin-top: 1rem; font-size: 0.85rem; color: var(--ts-text-muted); text-align: right; }

    .flow-wrapper { margin-top: 3.5rem; position: relative; }
    .flow-connector { display: none; }
    .flow-grid { gap: 1.25rem; position: relative; z-index: 1; }
    .flow-step { text-align: left; width: 100%; }
    .flow-step-top { display: flex; align-items: center; justify-content: space-between; }
    .flow-step-num { font-size: 0.8rem; font-weight: 700; color: var(--ts-accent-cyan); padding: 0.2rem 0.55rem; border-radius: 4px; background: var(--ts-input-bg); border: 1px solid var(--ts-input-border); }
    .flow-step h3 { font-size: 1.15rem; }
    .flow-step-desc { max-height: 0; overflow: hidden; opacity: 0; transition: 0.35s ease; color: var(--ts-text-muted); font-size: 0.9rem; }
    .flow-step.active, .flow-step:hover, .flow-step:focus-visible { border-color: var(--ts-accent-cyan); box-shadow: 0 0 18px -6px var(--ts-accent-cyan); outline: none; }
    .flow-step.active .flow-step-desc, .flow-step:hover .flow-step-desc, .flow-step:focus-visible .flow-step-desc { max-height: 120px; opacity: 1; margin-top: 0.75rem; }

    /* Responsive Breakpoints */
    @media (min-width: 640px) {
      .service-card { flex: 0 0 46%; }
      .spec-details, .charts-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 768px) {
      .slider-header-row { flex-direction: row; align-items: flex-end; justify-content: space-between; }
      .slider-header-row .section-header { margin-bottom: 0; }
      .criteria-layout { grid-template-columns: 1.65fr 1fr; }
      .flow-grid { grid-template-columns: repeat(3, 1fr); }
      .flow-connector { display: block; position: absolute; top: 28px; left: 10%; right: 10%; height: 2px; background: var(--ts-input-border); overflow: hidden; }
      .flow-connector::after { content: ""; position: absolute; top: 0; left: -40%; width: 40%; height: 100%; background: linear-gradient(90deg, transparent, var(--ts-accent-cyan), var(--ts-accent-purple), transparent); animation: flowLine 3.5s linear infinite; }
      @keyframes flowLine { to { left: 100%; } }
    }
    @media (min-width: 1024px) {
      .section-container { padding: 6.5rem 2rem; }
      .service-card { flex: 0 0 31.5%; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
      .reveal, .hero-word { opacity: 1 !important; transform: none !important; }
    }
  </style>
</head>
<body>

  <div id="scroll-progress" aria-hidden="true"></div>

  <main>
    <!-- Hero Section -->
    <section id="hero">
      <div class="hero-orb hero-orb-cyan" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-purple" aria-hidden="true"></div>

      <div class="hero-content">
        <span class="badge">Creator Management</span>
        <h1 id="hero-headline">
          <span class="hero-word">We</span>
          <span class="hero-word">Help</span>
          <span class="hero-word gradient-text">Creators</span>
          <span class="hero-word">Build</span>
          <span class="hero-word gradient-text">Real</span>
          <span class="hero-word gradient-text">Brands.</span>
        </h1>
        <p class="hero-subtext reveal">
          TechStora manages creators across every platform. We use competitor data and handle your production.
        </p>
        <div class="hero-actions reveal">
          <button type="button" class="btn btn-primary">Contact Us</button>
          <a href="REPLACE_WITH_APP_LINK" target="_blank" rel="noopener" class="btn btn-secondary">Explore the App</a>
        </div>
      </div>

      <div class="scroll-indicator" aria-hidden="true">
        <span>Scroll</span>
        <div class="scroll-line"></div>
      </div>
    </section>

    <!-- Services Slider -->
    <section id="services" class="section-container">
      <div class="slider-header-row reveal">
        <div class="section-header">
          <h2>How We Help You Grow</h2>
          <p>We handle daily production, channel strategy, and brand deals so you can focus on creating.</p>
        </div>
        <div class="slider-controls">
          <button type="button" class="slider-btn" id="slider-prev" aria-label="Previous service" disabled>
            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="slider-btn" id="slider-next" aria-label="Next service">
            <svg width="18" height="18" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div class="services-track" id="services-track" tabindex="0" aria-label="Creator services slider">
        <article class="ts-card service-card reveal">
          <div class="service-icon"><svg width="22" height="22" viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg></div>
          <h3>Video Editing</h3>
          <p>Clean cuts and good pacing that keep viewers watching.</p>
        </article>
        <article class="ts-card service-card reveal">
          <div class="service-icon"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div>
          <h3>Video Scripting</h3>
          <p>Clear, researched scripts with strong hooks that hold attention and boost watch time.</p>
        </article>
        <article class="ts-card service-card reveal">
          <div class="service-icon"><svg width="22" height="22" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
          <h3>Thumbnails</h3>
          <p>Clear, eye-catching thumbnails that get more clicks.</p>
        </article>
        <article class="ts-card service-card reveal">
          <div class="service-icon"><svg width="22" height="22" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg></div>
          <h3>Channel Audits</h3>
          <p>A close review of your retention drop-offs, audience data, and missed content opportunities.</p>
        </article>
        <article class="ts-card service-card reveal">
          <div class="service-icon"><svg width="22" height="22" viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></div>
          <h3>Growth Strategy</h3>
          <p>A clear publishing plan to grow your subscribers and expand your reach across platforms.</p>
        </article>
        <article class="ts-card service-card reveal">
          <div class="service-icon"><svg width="22" height="22" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
          <h3>Income Management</h3>
          <p>We handle brand sponsorships, ad revenue, and payouts across all your platforms in one place.</p>
        </article>
      </div>

      <div class="slider-progress-bar" aria-hidden="true">
        <div class="slider-progress-fill" id="slider-progress-fill"></div>
      </div>
    </section>

    <!-- Criteria Section -->
    <section id="criteria" class="section-container">
      <div class="section-header reveal">
        <h2>Who Qualifies for Full Management</h2>
        <p>Here is what we look for before taking a creator on for full management.</p>
      </div>

      <div class="criteria-layout">
        <article class="ts-card spec-sheet reveal">
          <div class="spec-header">
            <h3>Full Management Criteria</h3>
            <span class="spec-status">Main Requirement</span>
          </div>
          <div class="spec-body">
            <div class="spec-metric-row">
              <div class="spec-count" id="criteria-counter">0M+</div>
              <p class="spec-main-criterion">
                You need 1,000,000+ subscribers or followers on any single platform, such as YouTube, Facebook, or Instagram. One platform is enough.
              </p>
            </div>
            <div class="spec-details">
              <div class="spec-detail-item">
                <span class="spec-label">Qualification Rule</span>
                <span class="spec-value">1M+ on Any One Platform</span>
              </div>
              <div class="spec-detail-item">
                <span class="spec-label">What We Cover</span>
                <span class="spec-value">Income Across All Platforms</span>
              </div>
            </div>
            <p class="muted">
              Once you join, TechStora manages your income on every platform. That includes brand deals, ad revenue, and licensing.
            </p>
          </div>
        </article>

        <article class="ts-card secondary-criteria-card reveal">
          <div>
            <span class="badge badge-purple">Standalone Services</span>
            <h3>Under 1 Million Followers?</h3>
            <p class="muted">
              If you are under 1,000,000 on a single platform, you do not qualify for full management yet. You can still hire us for standalone services at a simple fixed fee.
            </p>
          </div>
          <div>
            <span class="spec-label">Fixed-Fee Services</span>
            <div class="standalone-tags">
              <span class="standalone-tag">Video Editing</span>
              <span class="standalone-tag">Thumbnail Design</span>
              <span class="standalone-tag">Channel Audit</span>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- Why Work With Us -->
    <section id="why-us" class="section-container">
      <div class="section-header reveal">
        <span class="badge">Internal Tool. Not Public Yet.</span>
        <h2>Why Work With Us</h2>
        <p>
          We study your competitors inside our internal TechStora App, which is not public yet. Then we use those insights to build a custom growth plan for your channel.
        </p>
      </div>

      <div class="charts-grid" id="charts-grid">
        <article class="ts-card chart-card reveal">
          <h3>Subscriber Growth</h3>
          <p class="chart-caption">Monthly subscriber count before and after working with TechStora.</p>
          <div class="chart-canvas-wrap"><canvas id="chart-growth" aria-label="Subscriber growth line chart"></canvas></div>
        </article>
        <article class="ts-card chart-card reveal">
          <h3>Competitor Comparison</h3>
          <p class="chart-caption">Average views per video compared to top channels in your niche.</p>
          <div class="chart-canvas-wrap"><canvas id="chart-competitors" aria-label="Competitor comparison bar chart"></canvas></div>
        </article>
        <article class="ts-card chart-card reveal">
          <h3>Where Views Come From</h3>
          <p class="chart-caption">How viewers find your videos across home feeds, suggested, and search.</p>
          <div class="chart-canvas-wrap"><canvas id="chart-traffic" aria-label="Traffic sources doughnut chart"></canvas></div>
        </article>
        <article class="ts-card chart-card reveal">
          <h3>Monthly Views</h3>
          <p class="chart-caption">Total monthly views across long-form videos and shorts.</p>
          <div class="chart-canvas-wrap"><canvas id="chart-views" aria-label="Monthly views area chart"></canvas></div>
        </article>
      </div>

      <p class="sample-data-note">Sample data for illustration.</p>

      <div class="flow-wrapper reveal">
        <div class="flow-connector" aria-hidden="true"></div>
        <div class="flow-grid">
          <button type="button" class="ts-card flow-step active">
            <div class="flow-step-top"><h3>Research</h3><span class="flow-step-num">Step 01</span></div>
            <div class="flow-step-desc">Our internal TechStora App tracks competitor upload schedules, retention patterns, and breakout topics to see what works.</div>
          </button>
          <button type="button" class="ts-card flow-step">
            <div class="flow-step-top"><h3>Plan</h3><span class="flow-step-num">Step 02</span></div>
            <div class="flow-step-desc">We use those findings to build a clear content plan covering video hooks, thumbnails, and posting schedules.</div>
          </button>
          <button type="button" class="ts-card flow-step">
            <div class="flow-step-top"><h3>Scale</h3><span class="flow-step-num">Step 03</span></div>
            <div class="flow-step-desc">We review every upload after it goes live and use what we learn to improve your next videos.</div>
          </button>
        </div>
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      try {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const cssVar = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

        // Hero & Scroll Progress
        document.querySelectorAll('#hero-headline .hero-word').forEach((word, i) => {
          setTimeout(() => word.classList.add('revealed'), reducedMotion ? 0 : 120 * i + 100);
        });

        const progressBar = document.getElementById('scroll-progress');
        window.addEventListener('scroll', () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          progressBar.style.width = `${max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0}%`;
        }, { passive: true });

        // Scroll Reveal & Flow Steps
        const revealObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            const siblings = [...entry.target.parentElement.children].filter((c) => c.classList.contains('reveal'));
            const idx = siblings.indexOf(entry.target);
            if (idx > 0 && !reducedMotion) entry.target.style.setProperty('--delay', `${idx * 85}ms`);
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        }, { threshold: 0.14 });

        document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

        document.querySelectorAll('.ts-card').forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
            card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
          });
        });

        const steps = document.querySelectorAll('.flow-step');
        steps.forEach((step) => step.addEventListener('click', () => {
          steps.forEach((s) => s.classList.remove('active'));
          step.classList.add('active');
        }));

        // Services Slider
        const track = document.getElementById('services-track');
        const prevBtn = document.getElementById('slider-prev');
        const nextBtn = document.getElementById('slider-next');
        const fill = document.getElementById('slider-progress-fill');
        let isDown = false, startX = 0, scrollStart = 0, velX = 0, lastX = 0, rafId = null;

        const updateSlider = () => {
          const max = track.scrollWidth - track.clientWidth;
          prevBtn.disabled = track.scrollLeft <= 4;
          nextBtn.disabled = track.scrollLeft >= max - 4;
          fill.style.width = `${max > 0 ? Math.min(100, Math.max(20, (track.scrollLeft / max) * 80 + 20)) : 100}%`;
        };
        const stepSize = () => (track.querySelector('.service-card')?.offsetWidth || 300) + 20;
        const slideBy = (dir) => track.scrollBy({ left: dir * stepSize(), behavior: reducedMotion ? 'auto' : 'smooth' });

        prevBtn.addEventListener('click', () => slideBy(-1));
        nextBtn.addEventListener('click', () => slideBy(1));
        track.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            slideBy(e.key === 'ArrowRight' ? 1 : -1);
          }
        });

        track.addEventListener('mousedown', (e) => {
          isDown = true; track.classList.add('is-dragging');
          startX = e.pageX - track.offsetLeft; scrollStart = track.scrollLeft; lastX = e.pageX; velX = 0;
          cancelAnimationFrame(rafId);
        });
        window.addEventListener('mouseup', () => {
          if (!isDown) return;
          isDown = false; track.classList.remove('is-dragging');
          const momentum = () => {
            if (!reducedMotion && Math.abs(velX) > 0.5) {
              track.scrollLeft -= velX; velX *= 0.92; rafId = requestAnimationFrame(momentum);
            }
          };
          momentum();
        });
        track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          velX = e.pageX - lastX; lastX = e.pageX;
          track.scrollLeft = scrollStart - (e.pageX - track.offsetLeft - startX) * 1.25;
        });
        track.addEventListener('scroll', updateSlider, { passive: true });
        window.addEventListener('resize', updateSlider);
        updateSlider();

        // Criteria Counter & Charts
        const counterEl = document.getElementById('criteria-counter');
        const sectionObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            obs.unobserve(entry.target);

            if (entry.target === counterEl) {
              if (reducedMotion) { counterEl.textContent = '1M+'; return; }
              const start = performance.now();
              const tick = (now) => {
                const p = Math.min((now - start) / 1200, 1);
                counterEl.textContent = p < 1 ? `${(1 - Math.pow(1 - p, 3)).toFixed(1)}M+` : '1M+';
                if (p < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            } else if (typeof Chart !== 'undefined') {
              const c = {
                bg: cssVar('--ts-bg-main'), cardBg: cssVar('--ts-card-bg'), border: cssVar('--ts-card-border'),
                cyan: cssVar('--ts-accent-cyan'), purple: cssVar('--ts-accent-purple'), text: cssVar('--ts-text-primary'),
                muted: cssVar('--ts-text-muted'), gold: cssVar('--ts-accent-gold'), danger: cssVar('--ts-accent-danger'),
                inBg: cssVar('--ts-input-bg'), inBorder: cssVar('--ts-input-border')
              };
              Chart.defaults.color = c.muted;
              Chart.defaults.borderColor = c.border;
              const baseOpts = {
                responsive: true, maintainAspectRatio: false,
                animation: reducedMotion ? false : { duration: 1100, easing: 'easeOutQuart' },
                plugins: {
                  legend: { labels: { color: c.text, boxWidth: 12 } },
                  tooltip: { backgroundColor: c.inBg, titleColor: c.text, bodyColor: c.muted, borderColor: c.inBorder, borderWidth: 1, padding: 10 }
                }
              };

              [
  ['chart-growth', 'line', ['M1', 'M2', 'M3', 'M4', 'M5', 'M6'], [
    { label: 'Before TechStora (Subscribers)', data: [500000, 520000, 535000, 555000, 575000, 600000], borderColor: c.muted, borderDash: [5, 5], tension: 0.35 },
    { label: 'After TechStora (Subscribers)', data: [505000, 560000, 640000, 730000, 830000, 950000], borderColor: c.cyan, backgroundColor: c.cardBg, tension: 0.35, borderWidth: 2.5 }
  ], { scales: { y: { min: 400000, max: 1000000, ticks: { callback: (v) => (v / 1000000).toFixed(1) + 'M' } } } }],
  ['chart-competitors', 'bar', ['Your Channel', 'Top Channel', 'Mid Channel', 'Peer Channel'], [
    { label: 'Avg. Views per Video', data: [520000, 810000, 640000, 500000], backgroundColor: [c.cyan, c.purple, c.inBorder, c.inBorder], borderRadius: 4 }
  ], { scales: { y: { min: 0, ticks: { callback: (v) => (v / 1000000).toFixed(1) + 'M' } } } }],
  ['chart-traffic', 'doughnut', ['Home & Browse', 'Suggested Videos', 'Search', 'External Links'], [
    { data: [44, 32, 16, 8], backgroundColor: [c.cyan, c.purple, c.gold, c.danger], borderColor: c.bg, borderWidth: 2 }
  ], { cutout: '64%' }],
  ['chart-views', 'line', ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'], [
    { label: 'Monthly Views', data: [520000, 580000, 650000, 740000, 850000, 980000], borderColor: c.purple, backgroundColor: c.border, fill: true, tension: 0.4, borderWidth: 2.5 }
  ], { scales: { y: { min: 400000, max: 1000000, ticks: { callback: (v) => (v / 1000000).toFixed(1) + 'M' } } } }]
]
.forEach(([id, type, labels, datasets, extra]) => {
                const el = document.getElementById(id);
                if (el) new Chart(el, { type, data: { labels, datasets }, options: { ...baseOpts, ...extra } });
              });
            }
          });
        }, { threshold: 0.25 });

        sectionObserver.observe(counterEl);
        sectionObserver.observe(document.getElementById('charts-grid'));
      } catch (err) {
        console.error('TechStora Frontend Initialization Error:', err);
      }
    });
  </script>
</body>
</html>
